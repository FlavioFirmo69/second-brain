# Destinazione Supabase (Shared pooler, porta 6543)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=require

# Sorgente SQL Server. Servono solo durante il trasferimento iniziale.
SOURCE_DB_SERVER=sql.example.com,1433
SOURCE_DB_NAME=ExistingDatabase
SOURCE_DB_USER=second_brain_app
SOURCE_DB_PASSWORD=change-me
SOURCE_DB_DRIVER=ODBC Driver 17 for SQL Server
SOURCE_DB_ENCRYPT=yes
SOURCE_DB_TRUST_SERVER_CERTIFICATE=no

# Configurazione applicativa già esistente
DEFAULT_USER_EMAIL=owner@secondbrain.local
