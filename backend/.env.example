APP_NAME=Second Brain
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Europe/Rome
FRONTEND_ORIGINS=http://localhost:5173

# SQL Server: il database deve esistere già.
DB_SERVER=sql.example.com,1433
DB_NAME=ExistingDatabase
DB_USER=second_brain_app
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# Utente iniziale presente nello script seed.
DEFAULT_USER_EMAIL=owner@secondbrain.local

# LLM opzionale. Esempio Gemini tramite endpoint compatibile OpenAI.
LLM_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
