APP_NAME=Second Brain
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Europe/Rome
FRONTEND_ORIGINS=http://localhost:5173

# Supabase/PostgreSQL. Usare la stringa Shared pooler e conservarla solo server-side.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?sslmode=require

# Utente iniziale presente nello script seed.
DEFAULT_USER_EMAIL=owner@secondbrain.local

# LLM opzionale. Esempio Gemini tramite endpoint compatibile OpenAI.
LLM_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
